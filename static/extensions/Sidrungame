    groupesDe({ PSEUDO }) { const u = this._user(PSEUDO); return u ? json(u.groupes) : '[]'; }
    membresGroupe({ GROUPE }) { const g = this._r(GROUPE); return json(Object.values(this.db.utilisateurs).filter((u) => u.groupes.includes(g)).map((u) => u.pseudo)); }
    listeGroupes() { return json(Object.keys(this.db.groupes)); }

    /* ═══════════ 2FA ═══════════ */
    activer2fa({ PSEUDO }) {
      const u = this._need(PSEUDO); if (!u) return '';
      if (u.totp.actif) { this._err('DEJA_ACTIVE'); return ''; }
      u.totp = { secret: b32enc(alea(20)), actif: false, dernier: 0 };
      this._log('2fa_initialisee', u.pseudo, ''); this._sauver(); this._ok(); return u.totp.secret;
    }
    async confirmer2fa({ PSEUDO, CODE }) {
      const u = this._need(PSEUDO); if (!u) return false;
      if (!u.totp.secret) { this._err('NON_CONFIGURE'); return false; }
      if (!(await this._verifTotp(u, CODE, false))) { this._err('CODE_2FA_INVALIDE'); return false; }
      u.totp.actif = true; this._log('2fa_activee', u.pseudo, ''); this._sauver(); this._ok(); return true;
    }
    desactiver2fa({ PSEUDO }) {
      const u = this._need(PSEUDO); if (!u) return;
      u.totp = { secret: '', actif: false, dernier: 0 }; u.secours = [];
      this._log('2fa_desactivee', u.pseudo, ''); this._sauver(); this._ok();
    }
    a2fa({ PSEUDO }) { const u = this._user(PSEUDO); return !!(u && u.totp.actif); }
    async verifierTotp({ CODE, PSEUDO }) { const u = this._user(PSEUDO); return !!u && (await this._verifTotp(u, CODE, false)); }
    async verifierTotpSecret({ CODE, SECRET }) {
      const code = String(CODE).replace(/\s/g, ''); if (!/^\d{6}$/.test(code) || !String(SECRET).trim()) return false;
      for (let d = -this.config.totpTolerance; d <= this.config.totpTolerance; d++) if (egal(await totp(SECRET, Date.now(), d), code)) return true;
      return false;
    }
    secret2fa({ PSEUDO }) { const u = this._user(PSEUDO); return u ? u.totp.secret : ''; }
    uri2fa({ PSEUDO }) {
      const u = this._user(PSEUDO); if (!u || !u.totp.secret) return '';
      const iss = encodeURIComponent(this.config.issuer);
      return `otpauth://totp/${iss}:${encodeURIComponent(u.pseudo)}?secret=${u.totp.secret}&issuer=${iss}&algorithm=SHA1&digits=6&period=30`;
    }
    async codeTotp({ SECRET }) { return String(SECRET).trim() ? totp(SECRET) : ''; }
    secondesTotp() { return 30 - (Math.floor(Date.now() / 1000) % 30); }
    genererSecretTotp() { return b32enc(alea(20)); }
    async genererSecours({ N, PSEUDO }) {
      const u = this._need(PSEUDO); if (!u) return '[]';
      const n = Math.round(num(N, 4, 20, 8)); const al = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; const codes = []; u.secours = [];
      for (let i = 0; i < n; i++) {
        let c = ''; for (let k = 0; k < 8; k++) c += choisir(al);
        codes.push(c.slice(0, 4) + '-' + c.slice(4));
        u.secours.push(await this._hSecours(c));
      }
      this._log('codes_secours_generes', u.pseudo, String(n)); this._sauver(); this._ok(); return json(codes);
    }
    async utiliserSecours({ CODE, PSEUDO }) {
      const u = this._need(PSEUDO); if (!u) return false;
      if (await this._consommerSecours(u, CODE)) { this._log('code_secours_utilise', u.pseudo, ''); this._sauver(); this._ok(); return true; }
      this._err('CODE_INVALIDE'); return false;
    }
    nombreSecours({ PSEUDO }) { const u = this._user(PSEUDO); return u ? u.secours.length : 0; }

    /* ═══════════ CODES & JETONS ═══════════ */
    async genererCode({ N, PSEUDO }) {
      const u = this._need(PSEUDO); if (!u) return '';
      const n = Math.round(num(N, 4, 10, 6)); let c = ''; for (let i = 0; i < n; i++) c += randInt(10);
      this.db.codes[u.id] = { h: await sha('SHA-256', `code:${u.id}:${c}`), expire: Date.now() + this.config.codeValiditeSec * 1000, essais: 0 };
      this._log('code_genere', u.pseudo, ''); this._sauver(); this._ok(); return c;
    }
    async verifierCode({ CODE, PSEUDO }) {
      const u = this._need(PSEUDO); if (!u) return false;
      const e = this.db.codes[u.id];
      if (!e || e.expire <= Date.now()) { this._err('CODE_INVALIDE'); return false; }
      if (++e.essais > 5) { delete this.db.codes[u.id]; this._sauver(); this._err('CODE_INVALIDE'); return false; }
      if (egal(await sha('SHA-256', `code:${u.id}:${String(CODE).trim()}`), e.h)) { delete this.db.codes[u.id]; this._sauver(); this._ok(); return true; }
      this._sauver(); this._err('CODE_INVALIDE'); return false;
    }
    codeEnAttente({ PSEUDO }) { const u = this._user(PSEUDO); const e = u && this.db.codes[u.id]; return !!(e && e.expire > Date.now()); }
    async jetonVerifEmail({ PSEUDO }) { const u = this._need(PSEUDO); if (!u) return ''; const j = await this._creerJeton('verification', u, 86400); this._ok(); return j; }
    async verifierEmail({ JETON }) {
      const u = await this._lireJeton('verification', JETON, true);
      if (!u) return this._err('JETON_INVALIDE');
      u.emailVerifie = true; this._log('email_verifie', u.pseudo, ''); this._sauver(); this._ok();
    }
    emailVerifie({ PSEUDO }) { const u = this._user(PSEUDO); return !!(u && u.emailVerifie); }
    async jetonReset({ PSEUDO }) { const u = this._need(PSEUDO); if (!u) return ''; const j = await this._creerJeton('reinitialisation', u, this.config.codeValiditeSec); this._log('jeton_reset', u.pseudo, ''); this._ok(); return j; }
    async reinitialiserAvecJeton({ JETON, MDP }) {
      const u = await this._lireJeton('reinitialisation', JETON, false);
      if (!u) return this._err('JETON_INVALIDE');
      const pb = this._problemesPolitique(String(MDP), u.pseudo);
      if (pb.length) return this._err('MDP_FAIBLE', TR('Le mot de passe doit ') + pb.join(', '));
      await this._lireJeton('reinitialisation', JETON, true);
      u.anciensHash.push(u.hash); u.anciensHash = u.anciensHash.slice(-Math.max(1, this.config.historiqueMdp));
      u.hash = await this._hasherPour(String(MDP), u); u.mdpChange = Date.now(); u.changementRequis = false; u.verrouJusqua = 0; u.echecs = 0;
      this._fermerSessionsDe(u, null);
      this.dernierPseudo = u.pseudo; this._log('mdp_reinitialise', u.pseudo, 'jeton'); this._emit('quandMdpChange'); this._sauver(); this._ok();
    }
    async jetonMagique({ PSEUDO }) { const u = this._need(PSEUDO); if (!u) return ''; const j = await this._creerJeton('magique', u, this.config.codeValiditeSec); this._ok(); return j; }
    async connecterMagique({ JETON }) {
      const u = await this._lireJeton('magique', JETON, true);
      if (!u) return this._err('JETON_INVALIDE');
      if (!u.actif) return this._err('COMPTE_DESACTIVE');
      await this._creerSession(u); this.dernierPseudo = u.pseudo;
      this._log('connexion_magique', u.pseudo, ''); this._emit('quandConnexion'); this._sauver(); this._ok();
    }
    async jetonValide({ TYPE, JETON }) { return !!(await this._lireJeton(String(TYPE), JETON, false)); }

    /* ═══════════ CLÉS API ═══════════ */
    async genererCleApi({ PSEUDO, NOM }) {
      const u = this._need(PSEUDO); if (!u) return '';
      const cle = 'sak_' + b64url(alea(24));
      this.db.cles[await sha('SHA-256', cle)] = { userId: u.id, nom: String(NOM).trim() || 'cle', cree: Date.now(), prefixe: cle.slice(0, 10) };
      this._log('cle_api_creee', u.pseudo, String(NOM)); this._sauver(); this._ok(); return cle;
    }
    async verifierCleApi({ CLE }) { const e = this.db.cles[await sha('SHA-256', String(CLE).trim())]; return !!(e && this.db.utilisateurs[e.userId]); }
    async utilisateurCleApi({ CLE }) { const e = this.db.cles[await sha('SHA-256', String(CLE).trim())]; const u = e && this.db.utilisateurs[e.userId]; return u ? u.pseudo : ''; }
    clesApiDe({ PSEUDO }) {
      const u = this._user(PSEUDO); if (!u) return '[]';
      return json(Object.values(this.db.cles).filter((k) => k.userId === u.id).map((k) => ({ nom: k.nom, prefixe: k.prefixe + '…', creee: iso(k.cree) })));
    }
    async revoquerCleApi({ CLE }) {
      const h = await sha('SHA-256', String(CLE).trim());
      if (!this.db.cles[h]) return this._err('JETON_INVALIDE');
      delete this.db.cles[h]; this._log('cle_api_revoquee', '', ''); this._sauver(); this._ok();
    }
    revoquerToutesCles({ PSEUDO }) {
      const u = this._need(PSEUDO); if (!u) return;
      for (const [k, v] of Object.entries(this.db.cles)) if (v.userId === u.id) delete this.db.cles[k];
      this._log('cles_api_revoquees', u.pseudo, ''); this._sauver(); this._ok();
    }

    /* ═══════════ JWT ═══════════ */
    async creerJwt({ PSEUDO, SEC, SECRET, ALGO }) {
      const u = this._need(PSEUDO); if (!u) return '';
      if (!String(SECRET)) { this._err('SECRET_VIDE'); return ''; }
      const t = Math.floor(Date.now() / 1000);
      const jwt = await jwtSigner({ sub: u.id, name: u.pseudo, role: u.role, iat: t, exp: t + Math.round(num(SEC, 1, 315360000, 3600)), iss: this.config.issuer }, String(SECRET), String(ALGO));
      this._ok(); return jwt;
    }
    async creerJwtCustom({ DONNEES, SEC, SECRET, ALGO }) {
      const o = parse(String(DONNEES), null);
      if (!o || typeof o !== 'object' || Array.isArray(o)) { this._err('DONNEES_INVALIDES'); return ''; }
      if (!String(SECRET)) { this._err('SECRET_VIDE'); return ''; }
      const t = Math.floor(Date.now() / 1000); o.iat = t;
      if (Number(SEC) > 0) o.exp = t + Math.round(num(SEC, 1, 315360000, 3600));
      const jwt = await jwtSigner(o, String(SECRET), String(ALGO)); this._ok(); return jwt;
    }
    async verifierJwt({ JWT, SECRET }) {
      const d = await jwtVerifier(JWT, String(SECRET)); const t = Date.now() / 1000;
      if (!d) { this._err('JETON_INVALIDE'); return false; }
      if ((typeof d.payload.exp === 'number' && d.payload.exp <= t) || (typeof d.payload.nbf === 'number' && d.payload.nbf > t)) { this._err('JETON_INVALIDE', TR('JWT expiré ou pas encore valide')); return false; }
      this._ok(); return true;
    }
    jwtExpire({ JWT }) { const d = jwtDecoder(JWT); return !!(d && typeof d.payload.exp === 'number' && d.payload.exp * 1000 <= Date.now()); }
    payloadJwt({ JWT }) { const d = jwtDecoder(JWT); return d ? json(d.payload) : ''; }
    champJwt({ CHAMP, JWT }) { const d = jwtDecoder(JWT); if (!d) return ''; const v = d.payload[String(CHAMP)]; return v === undefined ? '' : typeof v === 'object' ? json(v) : v; }
    expirationJwt({ JWT }) { const d = jwtDecoder(JWT); return d && typeof d.payload.exp === 'number' ? iso(d.payload.exp * 1000) : ''; }

    /* ═══════════ CRYPTO ═══════════ */
    async hacher({ TXT, ALGO }) { const a = ['SHA-1', 'SHA-256', 'SHA-384', 'SHA-512'].includes(String(ALGO)) ? String(ALGO) : 'SHA-256'; return sha(a, String(TXT)); }
    async hmac({ TXT, CLE, ALGO }) { const a = ['SHA-1', 'SHA-256', 'SHA-384', 'SHA-512'].includes(String(ALGO)) ? String(ALGO) : 'SHA-256'; return hex(await hmacRaw(a, enc.encode(String(CLE)), enc.encode(String(TXT)))); }
    async hacherMdp({ MDP }) { return this._hasher(String(MDP)); }
    async verifierHachage({ MDP, HASH }) { return this._verifierHash(String(MDP), String(HASH).trim()); }
    async signer({ TXT, CLE }) { return b64url(await hmacRaw('SHA-256', enc.encode(String(CLE)), enc.encode(String(TXT)))); }
    async verifierSignature({ SIG, TXT, CLE }) { return egal(await this.signer({ TXT, CLE }), String(SIG).trim()); }
    genererSel() { return hex(alea(16)); }
    jetonAleatoire({ N }) { return b64url(alea(Math.round(num(N, 1, 1024, 32)))); }
    genererUuid() { return uuid(); }
    nombreAleatoire({ MIN, MAX }) {
      let a = Math.floor(Number(MIN)), z = Math.floor(Number(MAX));
      if (!isFinite(a)) a = 0; if (!isFinite(z)) z = 100; if (a > z) [a, z] = [z, a];
      return a + randInt(z - a + 1);
    }
    base64Encoder({ TXT }) { return b64(enc.encode(String(TXT))); }
    base64Decoder({ TXT }) { try { return dec.decode(deB64(TXT)); } catch (e) { return ''; } }
    base64urlEncoder({ TXT }) { return b64urlStr(String(TXT)); }
    hexEncoder({ TXT }) { return hex(enc.encode(String(TXT))); }
    hexDecoder({ TXT }) { try { return dec.decode(deHex(TXT)); } catch (e) { return ''; } }

    /* ═══════════ VALIDATION & ANTI-ROBOT ═══════════ */
    emailValide({ EMAIL }) { return emailOk(String(EMAIL).trim()); }
    pseudoValide({ PSEUDO }) { return this._pseudoOk(String(PSEUDO).trim()); }
    emailJetable({ EMAIL }) { return JETABLES.has(this.domaineEmail({ EMAIL })); }
    domaineEmail({ EMAIL }) { const e = String(EMAIL).trim().toLowerCase(); const i = e.lastIndexOf('@'); return i < 0 ? '' : e.slice(i + 1); }
    normaliserEmail({ EMAIL }) { return String(EMAIL).trim().toLowerCase(); }
    masquerEmail({ EMAIL }) {
      const e = String(EMAIL).trim(); const i = e.lastIndexOf('@'); if (i < 1) return e;
      const l = e.slice(0, i); return (l.length > 1 ? l[0] + '*'.repeat(Math.min(l.length - 1, 8)) : '*') + e.slice(i);
    }
    captchaMath() {
      let a = randInt(20) + 1, b = randInt(20) + 1; const op = ['+', '-', '×'][randInt(3)];
      if (op === '-' && b > a) [a, b] = [b, a];
      const rep = op === '+' ? a + b : op === '-' ? a - b : a * b;
      this.captcha = { rep: String(rep), expire: Date.now() + 120000, essais: 0 };
      return `${a} ${op} ${b} = ?`;
    }
    captchaTexte({ N }) {
      const al = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; const n = Math.round(num(N, 3, 12, 5)); let t = '';
      for (let i = 0; i < n; i++) t += choisir(al);
      this.captcha = { rep: t.toLowerCase(), expire: Date.now() + 120000, essais: 0 }; return t;
    }
    verifierCaptcha({ REP }) {
      const c = this.captcha;
      if (!c || c.expire <= Date.now()) { this.captcha = null; return this._err('CODE_INVALIDE', TR('Captcha expiré')); }
      if (egal(String(REP).trim().toLowerCase(), c.rep)) { this.captcha = null; this._ok(); return true; }
      if (++c.essais >= 3) this.captcha = null;
      this._err('CODE_INVALIDE', TR('Réponse au captcha incorrecte')); return false;
    }
    autoriserAction({ CLE, N, SEC }) {
      const k = String(CLE), t = Date.now(), w = num(SEC, 1, 86400, 60) * 1000;
      const arr = (this.limites[k] || []).filter((x) => t - x < w);
      if (arr.length >= Math.max(1, Math.round(Number(N)))) { this.limites[k] = arr; this._err('LIMITE', TR('Trop de requêtes, réessayez plus tard')); return false; }
      arr.push(t); this.limites[k] = arr; return true;
    }

    /* ═══════════ DONNÉES DE PROFIL ═══════════ */
    async definirDonnee({ CLE, PSEUDO, VAL }) {
      const u = this._need(PSEUDO); if (!u) return;
      const k = String(CLE).trim(); if (!k) return this._err('DONNEES_INVALIDES');
      if (!(k in u.donnees) && Object.keys(u.donnees).length >= 200) return this._err('DONNEES_INVALIDES', TR('Limite de 200 données atteinte'));
      const ancien = u.donnees[k]; u.donnees[k] = String(VAL);
      if (this._cloudActif() && !u.localInvite) {
        try { await this._cloudDocBytes(0); } catch (e) {
          if (ancien === undefined) delete u.donnees[k]; else u.donnees[k] = ancien;
          return this._err(e.message === 'ILLISIBLE' ? 'CLOUD_ILLISIBLE' : e.message === 'BASE_PLEINE' ? 'BASE_PLEINE' : 'CLOUD_INDISPONIBLE');
        }
      }
      this._sauver(); this._ok();
    }
    supprimerDonnee({ CLE, PSEUDO }) { const u = this._need(PSEUDO); if (!u) return; delete u.donnees[String(CLE).trim()]; this._sauver(); this._ok(); }
    definirDonneeCourant({ CLE, VAL }) {
      this._toucher(); const u = this._courant(); if (!u) return this._err('NON_CONNECTE');
      return this.definirDonnee({ CLE, PSEUDO: u.id, VAL });
    }
    donnee({ CLE, PSEUDO }) { const u = this._user(PSEUDO); const v = u && u.donnees[String(CLE).trim()]; return v === undefined || v === null ? '' : v; }
    donneeCourant({ CLE }) { this._toucher(); const u = this._courant(); const v = u && u.donnees[String(CLE).trim()]; return v === undefined || v === null ? '' : v; }
    donneesJson({ PSEUDO }) { const u = this._user(PSEUDO); return u ? json(u.donnees) : '{}'; }

    /* ═══════════ JOURNAL ═══════════ */
    journaliser({ MSG, PSEUDO }) { this._log('personnalise', String(PSEUDO), String(MSG)); this._sauver(); this._ok(); }
    viderJournal() { this.db.journal = []; this._sauver(); this._ok(); }
    nbJournal() { return this.db.journal.length; }
    _fmtJ(e) { return e ? `${iso(e.t)} | ${e.type} | ${e.pseudo} | ${e.detail}` : ''; }
    _objJ(e) { return { date: iso(e.t), type: e.type, pseudo: e.pseudo, detail: e.detail }; }
    journalJson({ N }) { return json(this.db.journal.slice(-Math.round(num(N, 1, 1000, 20))).map((e) => this._objJ(e))); }
    journalDe({ PSEUDO }) { const p = String(PSEUDO).toLowerCase(); return json(this.db.journal.filter((e) => e.pseudo.toLowerCase() === p).slice(-200).map((e) => this._objJ(e))); }
    entreeJournal({ N }) { return this._fmtJ(this.db.journal[Math.round(Number(N)) - 1]); }
    dernierEvenementJ() { return this._fmtJ(this.db.journal[this.db.journal.length - 1]); }
    nbEvenementsType({ TYPE }) { const t = String(TYPE).trim(); return this.db.journal.filter((e) => e.type === t).length; }

    /* ═══════════ BASE DE DONNÉES ═══════════ */
    sauvegarder() { if (this._sauverMaintenant()) this._ok(); else this._err('STOCKAGE'); }
    recharger() {
      this.cleSession = null; this._jeton = null;
      if (this._charger()) { this._restaurerAuto(); this._ok(); } else this._err('STOCKAGE', TR('Aucune sauvegarde trouvée pour cette base'));
    }
    viderBase() {
      this.db = dbVide(); this.cleSession = null; this._jeton = null; this._oubliSession();
      this._sauverMaintenant(); this._ok();
    }
    exporterBase() { const c = { ...this.config }; delete c.poivre; return json({ ...this.db, config: c }); }
    async exporterChiffree({ MDP }) {
      if (!String(MDP)) { this._err('SECRET_VIDE'); return ''; }
      const r = await chiffrer(this.exporterBase(), String(MDP)); this._ok(); return r;
    }
    _appliquer(o) {
      if (!o || typeof o !== 'object' || typeof o.utilisateurs !== 'object') return false;
      this.db = this._normaliser(o);
      if (o.config && typeof o.config === 'object') for (const k of Object.keys(CONFIG_DEFAUT)) if (typeof o.config[k] === typeof CONFIG_DEFAUT[k]) this.config[k] = o.config[k];
      this.cleSession = null; this._jeton = null; this._oubliSession();
      this._log('base_importee', '', ''); this._sauverMaintenant(); return true;
    }
    importerBase({ DONNEES }) { if (this._cloudActif()) return this._err('CLOUD_INDISPONIBLE', TR('Import désactivé en mode cloud : les comptes vivent dans le cloud')); if (this._appliquer(parse(String(DONNEES), null))) this._ok(); else this._err('DONNEES_INVALIDES'); }
    async importerChiffree({ DATA, MDP }) {
      if (this._cloudActif()) return this._err('CLOUD_INDISPONIBLE', TR('Import désactivé en mode cloud : les comptes vivent dans le cloud'));
      try {
        if (this._appliquer(parse(await dechiffrer(String(DATA), String(MDP)), null))) this._ok(); else this._err('DONNEES_INVALIDES');
      } catch (e) { this._err('DONNEES_INVALIDES', TR('Mot de passe incorrect ou sauvegarde corrompue')); }
    }
    tailleBase() { return new Blob([this.exporterBase()]).size; }
    async empreinteBase() { return sha('SHA-256', this.exporterBase()); }
    telecharger() {
      const d = new Date(); const p = (x) => String(x).padStart(2, '0');
      const nom = `sidrunauth-${this.nomBase}-${d.getFullYear()}${p(d.getMonth() + 1)}${p(d.getDate())}-${p(d.getHours())}${p(d.getMinutes())}.json`;
      const url = URL.createObjectURL(new Blob([this.exporterBase()], { type: 'application/json' }));
      const a = document.createElement('a'); a.href = url; a.download = nom; document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 2000); this._ok();
    }

    /* ═══════════ STATUT ═══════════ */
    actionReussie() { return this.succes; }
    derniereErreur() { return this.succes ? '' : this.detailErreur; }
    codeErreur() { return this._codeErr; }
    messageCode({ CODE }) { const c = String(CODE).trim(); return MESSAGES[c] ? msgCode(c) : ''; }
    version() { return 'SidrunAuth ' + VERSION; }
    statistiques() {
      const us = Object.values(this.db.utilisateurs); const t = Date.now();
      return json({
        utilisateurs: us.length, sessionsActives: Object.values(this.db.sessions).filter((s) => s.expire > t).length,
        connexions: this.db.stats.connexions, echecs: this.db.stats.echecs, inscriptions: this.db.stats.inscriptions,
        avec2fa: us.filter((u) => u.totp.actif).length, verrouilles: us.filter((u) => u.verrouJusqua > t).length,
        roles: Object.keys(this.db.roles).length, groupes: Object.keys(this.db.groupes).length, clesApi: Object.keys(this.db.cles).length,
        entreesJournal: this.db.journal.length, tailleOctets: this.tailleBase(), base: this.nomBase, stockage: this._cloudActif() ? 'cloud' : 'local'
      });
    }
  }


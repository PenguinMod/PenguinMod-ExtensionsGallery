    async cloudEffacerTout() {
      this._cvMemo = null; this._cloudMaj();
      if (!this._cloudActif()) return this._err('CLOUD_INDISPONIBLE');
      while (this._cloudFlushing) await attente(50);
      this._cloudFlushing = true;
      try {
        this._cloudEcrireDoc(await this._cloudDocBytes((this._cloudRevDoc + 1) & 0xffff, true));
        this._cloudNouveaux = {}; this._cloudSupprimes.clear(); this._cloudInvalideDepuis = 0; this._cloudCorrompu = false;
        this._log('cloud_efface', '', 'tous les comptes');
      } finally { this._cloudFlushing = false; }
      await attente(300); await this._cloudSync(true); this._ok();
    }
    _cloudCapOctets() { return Math.max(0, Math.floor((this._cloudNbVars() * (this.config.cloudLargeur - 1)) / 2.40824) - 1); }
    _cloudDoc() { const c = this._cloudDocCache; return c && c.doc ? c.doc : null; }
    _cloudMoyenne() { const d = this._cloudDoc(); return d && d.users.length ? Math.max(30, (d.len - 16) / d.users.length) : 40; }
    cloudPret() { return this._cloudNbVars() >= 1 && this._cloudProvider(); }
    cloudModeActif() { return this._cloudActif(); }
    modeStockageActuel() { return this._cloudActif() ? 'cloud' : 'local'; }
    variablesCloudDetectees() { return this._cloudNbVars(); }

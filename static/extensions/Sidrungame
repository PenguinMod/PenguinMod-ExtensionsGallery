  class SidrunAuth {
    constructor() {
      this.config = { ...CONFIG_DEFAUT };
      this.nomBase = 'defaut';
      this.db = dbVide();
      this.cleSession = null; this._jeton = null;
      this._codeErr = 'OK'; this.detailErreur = ''; this.succes = true;
      this.dernierPseudo = '';
      this.limites = {}; this.captcha = null; this.fenetre = null;
      this.memoriserSession = true;
      this._tickN = 0; this._tSauve = null; this._tCloud = null;
      this._cloudMiens = new Set(); this._cloudBusy = false; this._cloudFlushing = false; this._cvMemo = null; this._cloudErr = ''; this._cloudInit = false;
      this._cloudReset();
      this._charger();
      this._cloudMaj();
      this._restaurerAuto();
      setInterval(() => this._tick(), 1000);
      window.addEventListener('beforeunload', () => this._sauverMaintenant());
    }

    /* ───────── Infrastructure ───────── */
    _cleStock() { return 'sidrunauth:' + this.nomBase; }
    _normaliser(o) {
      const d = dbVide();
      if (o && typeof o === 'object') {
        for (const k of ['utilisateurs', 'roles', 'groupes', 'sessions', 'jetons', 'cles', 'codes', 'stats']) {
          if (o[k] && typeof o[k] === 'object' && !Array.isArray(o[k])) d[k] = o[k];
        }
        if (Array.isArray(o.journal)) d.journal = o.journal;
      }
      if (!Object.keys(d.roles).length) d.roles = rolesDefaut();
      for (const r of Object.values(d.roles)) { r.permissions = Array.isArray(r.permissions) ? r.permissions : []; r.niveau = Number(r.niveau) || 0; }
      for (const g of Object.values(d.groupes)) g.permissions = Array.isArray(g.permissions) ? g.permissions : [];
      d.stats = { inscriptions: 0, connexions: 0, echecs: 0, ...d.stats };
      for (const u of Object.values(d.utilisateurs)) {
        u.groupes = u.groupes || []; u.permissions = u.permissions || []; u.donnees = u.donnees || {};
        u.secours = u.secours || []; u.anciensHash = u.anciensHash || []; u.totp = u.totp || { secret: '', actif: false };
      }
      return d;
    }
    _charger() {
      try {
        const brut = localStorage.getItem(this._cleStock());
        if (brut) {
          const o = JSON.parse(brut);
          this.db = this._normaliser(o);
          this.config = { ...CONFIG_DEFAUT, ...(o.config || {}) };
          return true;
        }
      } catch (e) { console.warn('[SidrunAuth] lecture impossible', e); }
      this.db = dbVide();
      return false;
    }
    _sauver() {
      if (this._cloudPrev) { clearTimeout(this._tCloud); this._tCloud = setTimeout(() => this._cloudFlush(), 200); }
      if (!this.config.persistant) return;
      clearTimeout(this._tSauve);
      this._tSauve = setTimeout(() => this._sauverMaintenant(), 150);
    }
    _sauverMaintenant() {
      if (!this.config.persistant) return false;
      try {
        const d = { ...this.db, config: { ...this.config, poivre: undefined } };
        if (this._cloudPrev) { // en mode cloud, les comptes vivent dans le cloud : on garde intacts les comptes locaux
          try { const o = JSON.parse(localStorage.getItem(this._cleStock()) || '{}'); d.utilisateurs = (o && o.utilisateurs) || {}; } catch (e) { d.utilisateurs = {}; }
          for (const u of Object.values(this.db.utilisateurs)) if (u.localInvite) d.utilisateurs[u.id] = u;
        }
        localStorage.setItem(this._cleStock(), JSON.stringify(d));
        return true;
      } catch (e) { console.warn('[SidrunAuth] écriture impossible', e); return false; }
    }
    _ok() { this.succes = true; this._codeErr = 'OK'; this.detailErreur = ''; return true; }
    _err(code, detail) { this.succes = false; this._codeErr = code; this.detailErreur = detail || msgCode(code); return false; }
    _emit(nom) { try { runtime.startHats('sidrunauth_' + nom); } catch (e) { /* ignore */ } }
    _log(type, pseudo, detail) {
      if (!this.config.journalActif) return;
      this.db.journal.push({ t: Date.now(), type: String(type), pseudo: String(pseudo || ''), detail: String(detail || '') });
      const max = this.config.journalMax;
      if (this.db.journal.length > max) this.db.journal.splice(0, this.db.journal.length - max);
    }
    _cle(p) { p = String(p).trim(); return this.config.casseInsensible ? p.toLowerCase() : p; }
    _r(x) { return String(x).trim().toLowerCase(); }
    _parPseudo(p) { const k = this._cle(p); for (const u of Object.values(this.db.utilisateurs)) if (this._cle(u.pseudo) === k) return u; return null; }
    _parEmail(e) { e = String(e).trim().toLowerCase(); if (!e) return null; for (const u of Object.values(this.db.utilisateurs)) if (u.email && u.email.toLowerCase() === e) return u; return null; }
    _user(i) { i = String(i).trim(); return this.db.utilisateurs[i] || this._parPseudo(i) || this._parEmail(i); }
    _need(p) { const u = this._user(p); if (!u) this._err('UTILISATEUR_INCONNU'); return u; }
    _pseudoOk(p) { const [a, b] = [this.config.pseudoMin, this.config.pseudoMax]; const L = [...p].length; return L >= a && L <= b && /^[\p{L}\p{N}_.\-]+$/u.test(p); }
    _courant() {
      const s = this.cleSession && this.db.sessions[this.cleSession];
      if (!s || s.expire <= Date.now()) return null;
      return this.db.utilisateurs[s.userId] || null;
    }
    _toucher() {
      const s = this.cleSession && this.db.sessions[this.cleSession];
      if (s && this.config.sessionGlissante && s.expire > Date.now()) { s.activite = Date.now(); s.expire = s.activite + this.config.sessionSec * 1000; }
    }
    _oubliSession() { try { localStorage.removeItem(this._cleStock() + ':session'); } catch (e) { /* ignore */ } }
    _tick() {

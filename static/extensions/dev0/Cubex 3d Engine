    getSpriteMenu() {
      const items = [
        { text: 'this sprite', value: '_myself_' },
        { text: 'Stage', value: '_stage_' },
      ];
      runtime.targets.forEach((t) => {
        if (t.isOriginal && !t.isStage) items.push({ text: t.sprite.name, value: t.sprite.name });
      });
      return items;
    }

    // ---------- setup / teardown ----------

  const injecterStyle = () => {
    if (document.getElementById('sidrunauth-style')) return;
    const s = document.createElement('style'); s.id = 'sidrunauth-style'; s.textContent = CSS; document.head.appendChild(s);
  };
  const popup = (titre, html, onFermer, brut) => {
    injecterStyle();
    if (LANGUE === 'en' && !brut) { titre = trHtml(titre); html = trHtml(html); }
    const fond = document.createElement('div'); fond.className = 'sa-fond';
    fond.innerHTML = '<div class="sa-carte" role="dialog" aria-modal="true"><div class="sa-tete"><span></span><button class="sa-x" title="Fermer">✕</button></div><div class="sa-corps"></div></div>';
    fond.querySelector('.sa-tete span').textContent = titre;
    const corps = fond.querySelector('.sa-corps'); corps.innerHTML = html;
    let ferme = false;
    const touche = (e) => { if (e.key === 'Escape') { e.stopPropagation(); fermer(); } };
    const fermer = () => {
      if (ferme) return; ferme = true;
      document.removeEventListener('keydown', touche, true);
      fond.remove();
      if (onFermer) onFermer();
    };
    document.addEventListener('keydown', touche, true);
    ['keydown', 'keyup', 'keypress'].forEach((ev) => fond.addEventListener(ev, (e) => e.stopPropagation()));
    fond.addEventListener('mousedown', (e) => { if (e.target === fond) fermer(); });
    fond.querySelector('.sa-x').title = LANGUE === 'en' ? 'Close' : 'Fermer'; fond.querySelector('.sa-x').onclick = fermer;
    document.body.appendChild(fond);
    return { fond, corps, fermer, q: (sel) => corps.querySelector(sel) };
  };


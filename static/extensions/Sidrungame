<div data-f="code-b" style="display:none"><label>Code 2FA (ou code de secours)</label><input class="sa-champ" data-f="code" inputmode="numeric" autocomplete="one-time-code"></div>
<div class="sa-msg" data-f="msg"></div><button class="sa-btn" data-f="ok" style="width:100%"></button>`, () => {
          C.fenetre = null;
          if (!reussi) C._err('ANNULE');
          resolve();
        });
        this.fenetre = p;
        const el = (f) => p.q(`[data-f="${f}"]`);
        const msg = (t, k) => { const e = el('msg'); e.textContent = t; e.className = 'sa-msg ' + (k || ''); };
        const maj = () => {
          p.corps.querySelectorAll('.sa-onglet').forEach((b) => b.classList.toggle('sa-actif', b.dataset.m === mode));
          const ins = mode === 'inscription';
          el('email-b').style.display = ins ? '' : 'none'; el('mdp2-b').style.display = ins ? '' : 'none'; el('barre-b').style.display = ins ? '' : 'none';
          el('ou').style.display = ins ? 'none' : ''; el('code-b').style.display = 'none';
          el('ok').textContent = TR(ins ? 'Créer mon compte' : 'Se connecter');
          el('mdp').autocomplete = ins ? 'new-password' : 'current-password'; msg('');
        };
        p.corps.querySelectorAll('.sa-onglet').forEach((b) => { b.onclick = () => { mode = b.dataset.m; maj(); }; });
        el('mdp').addEventListener('input', () => {
          const a = analyser(el('mdp').value);
          el('barre').style.width = a.score + '%'; el('barre').style.background = `hsl(${Math.round(a.score * 1.2)},80%,55%)`;
          el('force').textContent = el('mdp').value ? L2(`Force : ${a.niveau} (${a.score}/100)`, `Strength: ${a.niveau} (${a.score}/100)`) : '';
        });
        const valider = async () => {
          if (occupe) return; occupe = true; el('ok').disabled = true;
          try {
            const id = el('ident').value, mdp = el('mdp').value;
            if (mode === 'inscription') {
              if (mdp !== el('mdp2').value) { msg(TR('Les mots de passe ne correspondent pas.'), 'err'); return; }
              if (!(await C._inscrire(id, el('email').value, mdp, 'utilisateur'))) { msg(C.detailErreur, 'err'); return; }
            }
            const code = el('code-b').style.display === 'none' ? null : el('code').value;
            if (await C._connecter(id, mdp, code)) {
              reussi = true; msg(TR('Bienvenue !'), 'ok'); setTimeout(() => p.fermer(), 450);
            } else if (C._codeErr === 'DEUX_FA_REQUIS') {
              el('code-b').style.display = ''; msg(TR('Entrez le code à 6 chiffres de votre application.'), 'ok'); el('code').focus();
            } else msg(C.detailErreur, 'err');
          } finally { occupe = false; el('ok').disabled = false; }
        };
        el('ok').onclick = valider;
        p.corps.querySelectorAll('input').forEach((i) => i.addEventListener('keydown', (e) => { if (e.key === 'Enter') valider(); }));
        maj(); el('ident').focus();
      });

          for (const id of ids) if (!anciens[id] && !this._cloudMiens.has(id)) { this.dernierPseudo = vus[id].pseudo; this._emit('quandCompteApparu'); }
          for (const [id, lu] of Object.entries(anciens)) if (!lu.localInvite && !ids.has(id) && !this._cloudSupprimes.has(id)) { this.dernierPseudo = lu.pseudo; this._emit('quandCompteDisparu'); }
        }
        this.db.utilisateurs = vus;
        for (const [k, s] of Object.entries(this.db.sessions)) { // révocation à distance : compte supprimé, désactivé ou mot de passe changé ailleurs
          const us = vus[s.userId];
          if (!us || !us.actif || (s.mdpRef !== undefined && Math.floor((us.mdpChange || 0) / 1000) !== s.mdpRef)) delete this.db.sessions[k];
        }
        this._cloudPret = true;
      } catch (e) { console.warn('[SidrunAuth] synchronisation cloud', e); this._cloudErr = String((e && e.message) || e); } finally { this._cloudBusy = false; }
    }
    _cloudSales() { return Object.values(this.db.utilisateurs).filter((u) => !u.localInvite && this._cloudSig[u.id] !== undefined && this._sig(u) !== this._cloudSig[u.id]); }
    async _cloudFlush() { // envoie les modifications locales (avec fusion et vérification : les écritures simultanées sont rejouées)
      while (this._cloudFlushing) await attente(50);
      if (!this._cloudActif()) return;
      this._cloudFlushing = true;
      try {
        for (let essai = 0; essai < 4; essai++) {
          if (!this._cloudSales().length && !this._cloudSupprimes.size) return;
          await this._cloudSync(true);
          const sales = this._cloudSales();
          if (!sales.length && !this._cloudSupprimes.size) return;
          const att = {}; for (const u of sales) att[u.id] = this._sig(u);
          let bytes;
          try { bytes = await this._cloudDocBytes((this._cloudRevDoc + 1) & 0xffff); } catch (e) {
            const m = String((e && e.message) || e);
            if (m === 'ILLISIBLE') return; // on réessaiera au prochain tick
            this._cloudErr = m; for (const u of sales) { this._log('cloud_erreur', u.pseudo, m); delete this._cloudSig[u.id]; } // retour à la version du cloud
            this._cloudSupprimes.clear(); await this._cloudSync(true); return;
          }
          this._cloudEcrireDoc(bytes); this._cloudRevDoc = (this._cloudRevDoc + 1) & 0xffff;
          for (const u of sales) this._cloudSig[u.id] = att[u.id];
          await attente(400);
          const doc = await this._cloudLireDoc();
          let perdu = !doc;
          if (doc) {
            for (const [id, sg] of Object.entries(att)) { const c = doc.byId[id]; if (!c || this._sig(c) !== sg) { this._cloudSig[id] = '#'; perdu = true; } }
            for (const id of [...this._cloudSupprimes]) { if (doc.byId[id]) perdu = true; else this._cloudSupprimes.delete(id); }
          }
          if (!perdu) return;
        }
      } finally { this._cloudFlushing = false; }
    }
    async _cloudCreer(u) { // renvoie true ou un code d’erreur
      if (this._cloudNbVars() < 1) return 'CLOUD_INDISPONIBLE';
      while (this._cloudFlushing) await attente(50);
      this._cloudFlushing = true; this._cloudMiens.add(u.id);
      try {
        for (let essai = 0; essai < 5; essai++) {
          await this._cloudSync(true);
          if (this._cloudInvalideDepuis) { await attente(500); continue; }
          const ex = this.db.utilisateurs[u.id] || this._parPseudo(u.pseudo);
          if (ex) return ex.hash === u.hash ? true : 'PSEUDO_PRIS';
          this._cloudNouveaux[u.id] = u;
          let bytes;
          try { bytes = await this._cloudDocBytes((this._cloudRevDoc + 1) & 0xffff); } catch (e) { return e.message === 'BASE_PLEINE' ? 'BASE_PLEINE' : 'CLOUD_INDISPONIBLE'; }
          this._cloudEcrireDoc(bytes);
          await attente(400);
          const doc = await this._cloudLireDoc(), c = doc && doc.byId[u.id];
          if (c) return c.hash === u.hash ? true : 'PSEUDO_PRIS'; // même pseudo créé au même instant ailleurs : le dernier écrit gagne
        }
        return this._cloudCorrompu ? 'CLOUD_ILLISIBLE' : 'CLOUD_INDISPONIBLE';
      } finally { delete this._cloudNouveaux[u.id]; await this._cloudSync(true); this._cloudFlushing = false; }
    }
    async _cloudSupprimer(u) { this._cloudSupprimes.add(u.id); delete this._cloudSig[u.id]; await this._cloudFlush(); }
    _creerVarsCloud(n) {
      const stage = runtime.getTargetForStage(); if (!stage) return -1;
      const pre = String(this.config.cloudPrefixe).replace(/[^A-Za-z0-9_]/g, '') || 'auth';
      const noms = new Set(Object.values(stage.variables).map((x) => x.name));
      let crees = 0;
      for (let i = 1; i <= n; i++) {
        const nom = `☁ ${pre}_${i}`; if (noms.has(nom)) continue;
        try { stage.createVariable(uuid(), nom, '', true); crees++; } catch (e) { console.warn('[SidrunAuth] création de variable cloud impossible', e); break; }
      }
      try { Scratch.vm.emitWorkspaceUpdate(); } catch (e) { /* ignore */ }
      this._cvMemo = null; return crees;
    }

    /* ───────── Cœur : inscription / connexion ───────── */
    async _inscrire(pseudo, email, mdp, role, invite) {
      pseudo = String(pseudo).trim(); email = String(email || '').trim(); mdp = String(mdp); role = this._r(role);
      await this._preparer();
      if (!this._pseudoOk(pseudo)) return this._err('PSEUDO_INVALIDE', L2(`Pseudo invalide (${this.config.pseudoMin} à ${this.config.pseudoMax} caractères : lettres, chiffres, _ . -)`, `Invalid username (${this.config.pseudoMin} to ${this.config.pseudoMax} characters: letters, digits, _ . -)`));
      if (this._parPseudo(pseudo)) return this._err('PSEUDO_PRIS');
      if (email === '' && this.config.emailObligatoire && !invite) return this._err('EMAIL_REQUIS');
      if (email !== '') {
        if (!emailOk(email)) return this._err('EMAIL_INVALIDE');
        if (this._parEmail(email)) return this._err('EMAIL_PRIS');
      }
      if (!this.db.roles[role]) return this._err('ROLE_INCONNU');
      if (!invite) {
        const pb = this._problemesPolitique(mdp, pseudo);
        if (pb.length) return this._err('MDP_FAIBLE', TR('Le mot de passe doit ') + pb.join(', '));
      }
      const cloudId = this._cloudActif() && !invite ? await this._idDe(pseudo) : null;
      const hash = cloudId ? await this._hasher(mdp, null, { sel: await this._selDe(cloudId), len: 16 }) : await this._hasher(mdp);
      if (this._parPseudo(pseudo)) return this._err('PSEUDO_PRIS');
      const u = {
        id: cloudId || uuid(), pseudo, email, hash, role, groupes: [], permissions: [], cree: Date.now(), derniereConnexion: 0, nbConnexions: 0,
        actif: true, emailVerifie: false, echecs: 0, verrouJusqua: 0, totp: { secret: '', actif: false, dernier: 0 }, secours: [],
        donnees: {}, anciensHash: [], mdpChange: Date.now(), changementRequis: false, invite: !!invite, localInvite: !!invite
      };
      if (cloudId) { const r = await this._cloudCreer(u); if (r !== true) return this._err(r); }
      this.db.utilisateurs[u.id] = u; this.db.stats.inscriptions++;
      this.dernierPseudo = pseudo; this._log('inscription', pseudo, role);
      this._emit('quandInscription'); this._sauver();
      return this._ok();
    }
    _echec(u, raison, code) {
      u.echecs = (u.echecs || 0) + 1; this.db.stats.echecs++;
      this._log('connexion_echec', u.pseudo, raison);
      let c = code, d = '';
      if (u.echecs >= this.config.essaisMax) {
        u.verrouJusqua = Date.now() + this.config.verrouSec * 1000;
        this._log('compte_verrouille', u.pseudo, this.config.verrouSec + 's');
        c = 'COMPTE_VERROUILLE'; d = `${L2('Trop d’essais : compte verrouillé pendant ', 'Too many attempts: account locked for ')}${duree(this.config.verrouSec)}`;
        this._emit('quandCompteVerrouille');
      }
      this._emit('quandConnexionEchouee'); this._sauver();
      return this._err(c, d);
    }
    async _connecter(ident, mdp, code) {
      ident = String(ident).trim(); mdp = String(mdp);
      await this._preparer();
      const u = this._user(ident);
      if (!u) {
        await pbkdf2(mdp, alea(16), this.config.iterations); // calcul factice
        this.db.stats.echecs++; this.dernierPseudo = ident;
        this._log('connexion_echec', ident, 'utilisateur inconnu');
        this._emit('quandConnexionEchouee'); this._sauver();
        return this._err('UTILISATEUR_INCONNU');
      }
      this.dernierPseudo = u.pseudo;
      if (!u.actif) return this._err('COMPTE_DESACTIVE');
      const t = Date.now();
      if (u.verrouJusqua > t) { this._emit('quandConnexionEchouee'); return this._err('COMPTE_VERROUILLE', `${L2('Compte verrouillé encore ', 'Account still locked for ')}${duree(Math.ceil((u.verrouJusqua - t) / 1000))}`); }
      if (u.verrouJusqua) { u.verrouJusqua = 0; u.echecs = 0; }
      if (!(await this._verifierHash(mdp, u.hash))) return this._echec(u, 'mot de passe incorrect', 'MDP_INCORRECT');
      if (u.totp.actif) {
        if (code === null || code === undefined || String(code).trim() === '') return this._err('DEUX_FA_REQUIS');
        const okc = (await this._verifTotp(u, code, true)) || (await this._consommerSecours(u, code));
        if (!okc) return this._echec(u, 'code 2FA incorrect', 'CODE_2FA_INVALIDE');
      }
      if (this.config.mdpAgeMaxJours > 0 && t - u.mdpChange > this.config.mdpAgeMaxJours * 864e5) u.changementRequis = true;
      await this._creerSession(u);
      this._log('connexion', u.pseudo, '');
      this._emit('quandConnexion'); this._sauver();
      return this._ok();
    }


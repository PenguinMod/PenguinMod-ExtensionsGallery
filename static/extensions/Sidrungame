    _aide(sujet) { const en = LANGUE === 'en' && !!AIDES_EN[sujet]; const a = (en && AIDES_EN[sujet]) || AIDES[sujet] || AIDES.general; popup(a.t, a.h, null, en); }
    aideGeneral() { this._aide('general'); }
    aideHachage() { this._aide('hachage'); }
    aide2fa() { this._aide('2fa'); }
    aideJwt() { this._aide('jwt'); }
    aideRoles() { this._aide('roles'); }
    aideVerrouillage() { this._aide('verrouillage'); }
    aidePolitique() { this._aide('politique'); }
    aidePersistance() { this._aide('persistance'); }
    aideCodes() { this._aide('codes'); }
    aideApi() { this._aide('apikeys'); }
    aideFenetre() { this._aide('fenetre'); }
    aidePopup({ SUJET }) { this._aide(String(SUJET)); }
    _setLangue(l) {
      LANGUE = l === 'en' ? 'en' : 'fr';
      try { localStorage.setItem('sidrunauth:langue', LANGUE); } catch (e) { /* ignore */ }
      try { Scratch.vm.extensionManager.refreshBlocks(); } catch (e) { /* ignore */ }
    }
    cfgLangue({ LANG }) { this._setLangue(String(LANG).toLowerCase().startsWith('en') ? 'en' : 'fr'); }
    langueActuelle() { return LANGUE; }
    choisirLangue() {
      const p = popup('🌐 Langues / Language', `<p>Choisissez la langue de l’extension / Choose the extension language (WARNING: When you change the language, save the project and then reload it in PenguinMod/Turbowarp so that the blocks are translated)</p>
<div class="sa-ligne"><button class="sa-btn" data-l="fr" style="flex:1">🇫🇷 Français</button><button class="sa-btn" data-l="en" style="flex:1">🇬🇧 English</button></div>
<p data-f="m" style="font-size:13px;opacity:.8;margin-top:12px"></p>`, null, true);
      p.corps.querySelectorAll('[data-l]').forEach((b) => {
        b.style.opacity = b.dataset.l === LANGUE ? '1' : '.65';
        b.onclick = () => {
          this._setLangue(b.dataset.l);
          p.q('[data-f="m"]').textContent = b.dataset.l === 'en' ? 'Language set to English. Refreshing the blocks…' : 'Langue réglée sur le français. Mise à jour des blocs…';
          setTimeout(() => p.fermer(), 700);
        };
      });
    }
    afficherMessage({ TITRE, TEXTE }) { popup(String(TITRE), '<p style="white-space:pre-wrap"></p>').q('p').textContent = String(TEXTE); }

